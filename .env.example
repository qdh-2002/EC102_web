# Database. SQLite file by default; see docs/DEPLOYMENT.md to use PostgreSQL.
DATABASE_URL="file:./dev.db"

# Long random string used to sign staff sessions. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Where uploaded course files are stored (must be persistent in production).
UPLOAD_DIR="./uploads"

# Max upload size in MB for slides/PDFs/videos uploaded through the admin.
MAX_UPLOAD_MB="100"

# Public URL of the site (used in links and metadata).
SITE_URL="http://localhost:3000"

# First admin account, created by `npm run db:seed` or `npm run create-admin`.
ADMIN_EMAIL="admin@example.edu"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Course Admin"

# Set to "false" to seed only the admin account and an empty current term (no sample content).
SEED_SAMPLE_CONTENT="true"
